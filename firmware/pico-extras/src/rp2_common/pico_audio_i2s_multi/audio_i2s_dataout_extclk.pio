; I2S external-clock slave output: 24-in-32 data only, clocked by an external
; master's BCK/LRCLK (GPIO inputs, BCK = 64 x Fs). Wait-driven at divider 1.0.
; Autopull 32, shift left, TX FIFO joined, JMP pin = LRCLK. Design, framing
; check and start alignment: current_architecture.md "Framing-slip watchdog".
;
; Wait GPIO indices are placeholders (0 = BCK, 1 = LRCLK) patched at load by
; i2s_extclk_load_program(). The frame starts at cell R32 (the bit before the
; left MSB), so the C side must prime the OSR to exactly one bit of frame 0
; before starting (i2s_extclk_prime()); a plain restart lands one sample off.

.program audio_i2s_dataout_extclk

public entry_point:
    wait 1 gpio 1               ; [LRCLK] be in the right half
    wait 0 gpio 1               ; [LRCLK] falling edge = start of cell R32
top:
    wait 0 gpio 0               ; [BCK] falling edge; also the LRCLK/BCK skew guard
    out pins, 1                 ; last bit of the previous right word (R32)
    wait 1 gpio 0               ; [BCK] mid R32
    jmp pin slip                ; LRCLK must be low here
    set y, 1
    set x, 31                   ; 32 bits: cells L1..L32
bit:
    wait 0 gpio 0               ; [BCK]
    out pins, 1
    wait 1 gpio 0               ; [BCK]
    jmp x-- bit
    jmp y-- second
    jmp pin top                 ; mid R31: LRCLK must be high
.wrap_target
slip:
    irq 7                       ; flag the slip and park; software restarts the SM
.wrap
second:
    set x, 30                   ; 31 bits: cells R1..R31
    jmp bit

% c-sdk {

// ---------------------------------------------------------------------------
// audio_i2s_dataout_extclk_program_init - configure a PIO SM as an
// external-clock I2S slave output (data pin only; clocks are inputs owned
// by the I2S clock-slave input path).
//
//   pio            - PIO block
//   sm             - state machine index
//   offset         - from pio_add_program() of the PATCHED program copy
//   data_pin       - GPIO for serial audio data OUT
//   clock_pin_base - GPIO of the externally driven BCK; LRCLK is +1 (JMP pin)
//
// Divider is forced to 1.0 (wait-driven).  Caller owns input enables on the
// BCK/LRCLK pads, clears PIO irq flag 7 before enabling, primes the OSR and
// starts execution at entry_point.
// ---------------------------------------------------------------------------
static inline void audio_i2s_dataout_extclk_program_init(PIO pio, uint sm, uint offset,
                                                         uint data_pin, uint clock_pin_base) {
    pio_sm_config sm_config = audio_i2s_dataout_extclk_program_get_default_config(offset);

    sm_config_set_out_pins(&sm_config, data_pin, 1);
    sm_config_set_out_shift(&sm_config, false, true, 32);
    sm_config_set_fifo_join(&sm_config, PIO_FIFO_JOIN_TX);
    sm_config_set_jmp_pin(&sm_config, clock_pin_base + 1);

    pio_sm_init(pio, sm, offset, &sm_config);
    pio_sm_set_clkdiv_int_frac(pio, sm, 1, 0);

    // Data pin output; BCK/LRCLK pindirs untouched (they are inputs)
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 1, true);
    pio_sm_set_pins_with_mask(pio, sm, 0, 1u << data_pin);

    pio_sm_exec(pio, sm, pio_encode_jmp(offset + audio_i2s_dataout_extclk_offset_entry_point));
}

%}
