// Grammar: Documentation/Features/vendor_command_overhaul_plan.md section 8.3.
VC_PAGE(SYS, 0x01, 1, "Discovery, identity, device name, last result, bootloader, system and stream telemetry")

VC_CMD(0x10, PROTOCOL_INFO, sys_protocol_info_get, VC_NONE,
       NONE, 16, 0, 0, 0, 0, "Protocol magic, version, page count and transfer limits")
VC_CMD(0x11, PAGE_LIST, sys_page_list_get, VC_NONE,
       NONE, VC_LEN_VAR, 0, 0, 0, 0, "Page number and revision of every implemented page")
VC_CMD(0x12, PAGE_COMMANDS, sys_page_commands_get, VC_NONE,
       PAGE, 64, 0, 0, 0, 0, "GET then SET bitmaps of the commands a page implements")
VC_CMD(0x13, COMMAND_INFO, sys_command_info_get, VC_NONE,
       PAGE_CMD, 8, 0, 0, 0, 0, "Flags, sizes and address kind of one command")
VC_CMD(0x14, LAST_RESULT, sys_last_result_get, VC_NONE,
       NONE, 8, 0, 0, 0, 0, "Result of the last request on this transport")

VC_CMD(0x20, PLATFORM, sys_platform_get, VC_NONE,
       NONE, 7, 0, 0, 0, 0, "Platform ID, packed version, output count, then minor, patch and beta numbers")
VC_CMD(0x21, SERIAL, sys_serial_get, VC_NONE,
       NONE, 16, 0, 0, 0, 0, "USB serial number string")
VC_CMD(0x22, BUILD_INFO, sys_build_info_get, VC_NONE,
       NONE, 64, 0, 0, 0, 0, "Git describe and build date")
VC_CMD(0x23, CORE1_MODE, sys_core1_mode_get, VC_NONE,
       NONE, 1, 0, 0, 0, 0, "Current core 1 mode")
VC_CMD(0x24, DEVICE_NAME, sys_device_name_get, sys_device_name_set,
       NONE, 32, 1, 32, VC_F_DEFERRED | VC_F_FLASH | VC_F_RESTART, 0, "Board name, NUL padded; a SET keeps at most 31 bytes")

VC_CMD(0x30, ENTER_BOOTLOADER, VC_NONE, sys_enter_bootloader_set,
       NONE, 0, 0, 0, VC_F_RESTART, 0, "Reboot into the USB bootloader after the reply has gone out")

VC_CMD(0x40, SYSTEM_STATUS, sys_system_status_get, VC_NONE,
       NONE, 16, 0, 0, 0, 0, "clk_sys Hz, sample rate Hz, core mV, temperature cdeg, CPU loads")
VC_CMD(0x41, USB_AUDIO_STATUS, sys_usb_audio_status_get, VC_NONE,
       NONE, 16, 0, 0, 0, 0, "USB audio packets, ring overruns, worst packet gap us, alt, mounted")
VC_CMD(0x42, BUFFER_STATS, sys_buffer_stats_get, VC_NONE,
       NONE, 44, 0, 0, 0, 0, "BufferStatsPacket; each read advances its sequence counter")
VC_CMD(0x43, PIPELINE_STATS, sys_pipeline_stats_get, VC_NONE,
       NONE, 24, 0, 0, 0, 0, "Output ring underruns, drops, min prewrite, input gap us, background over budget")
VC_CMD(0x44, PDM_STATS, sys_pdm_stats_get, VC_NONE,
       NONE, 16, 0, 0, 0, 0, "PDM ring overruns, ring underruns, DMA overruns, DMA underruns")
VC_CMD(0x45, SPDIF_TX_STATS, sys_spdif_tx_stats_get, VC_NONE,
       NONE, 24, 0, 0, 0, 0, "USB audio packet gaps of 2 to 50 ms, total output DMA starvations, starvations of instances 0-3")
VC_CMD(0x4F, STATS_RESET, VC_NONE, sys_stats_reset_set,
       NONE, 0, 1, 1, 0, 0, "Bitmask; bit 0 resets buffer watermarks and worst-gap fields")
