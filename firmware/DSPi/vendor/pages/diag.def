// Grammar: Documentation/Features/vendor_command_overhaul_plan.md section 8.8.
// Every command here exists only in the bench build that enables it.
VC_PAGE(DIAG, 0xF0, 1, "Bench and diagnostic commands with no stability promise")

// config.h defines DSPI_CLOCK_DIAG as 0 when it is off, so this one needs #if.
#if DSPI_CLOCK_DIAG
VC_CMD(0x10, CLOCK_DIAG, diag_clock_diag_get, VC_NONE,
       NONE, VC_LEN_VAR, 0, 0, 0, 0, "Latest 1 Hz ClockDiagPacket snapshot")
#endif

#ifdef DSPI_LOOPBACK
VC_CMD(0x20, LOOPBACK_STATS, diag_loopback_stats_get, VC_NONE,
       NONE, 8, 0, 0, 0, 0, "Loopback capture overflow and underrun frame counts")
#endif

// Worst times are in us since boot or LOOP_PROF_RESET; reads never clear them.
// Section and job numbers are the order of the lists in loop_prof.h.
#ifdef DSPI_LOOP_PROF
VC_CMD(0x30, LOOP_PROF_SECTION, diag_lp_section_get, VC_NONE,
       INDEX, 4, 0, 0, 0, 0, "Worst time of main-loop section wValue (LOOP_PROF_SECTION_LIST)")
VC_CMD(0x31, LOOP_PROF_JOB, diag_lp_job_get, VC_NONE,
       INDEX, 4, 0, 0, 0, 0, "Worst step of background job wValue (BG_JOB_LIST)")
VC_CMD(0x32, LOOP_PROF_COMMAND, diag_lp_command_get, VC_NONE,
       PAGE_CMD, 4, 0, 0, 0, 0, "Worst handler time of paged command wValue, GET and SET together")
VC_CMD(0x33, LOOP_PROF_BG_PACE, diag_lp_bg_pace_get, diag_lp_bg_pace_set,
       NONE, 2, 2, 2, 0, 0, "Background pacing n: above 1, one unit per step on one pass in n; 0 sets 1")
VC_CMD(0x34, LOOP_PROF_RESET, VC_NONE, diag_lp_reset_set,
       NONE, 0, 0, 0, 0, 0, "Zero every section, job and command worst time")
#endif

// Totals accumulate since boot; the host differences two reads. RESET_MIN only restarts the minima.
#ifdef DSPI_EQ_PROF
VC_CMD(0x40, EQ_PROF, diag_eq_prof_get, VC_NONE,
       NONE, 48, 0, 0, 0, 0, "Per core: u64 cycles, u32 calls, u32 samples, u32 min call cycles, u32 its samples")
VC_CMD(0x41, EQ_PROF_RESET_MIN, VC_NONE, diag_eq_prof_reset_min_set,
       NONE, 0, 0, 0, 0, 0, "Restart the per-call minimum on both cores")
#endif

// Wire-capture rig: Documentation/Features/wirecap_test_rig.md has every payload layout.
#ifdef DSPI_WIRECAP
VC_CMD(0x50, WIRECAP_ARM, VC_NONE, diag_wirecap_arm_set,
       NONE, 0, 10, 10, 0, 0, "Start a one-shot pin capture: u8 base, u8 count, u16 div int, u8 div frac, u8 0, u32 bytes (0 aborts)")
VC_CMD(0x51, WIRECAP_STATUS, diag_wirecap_status_get, VC_NONE,
       NONE, 32, 0, 0, 0, 0, "Capture state, RXSTALL flag, pins, clk_sys Hz, divider, PIO, bytes, buffer size, sequence")
VC_CMD(0x52, WIRECAP_READ, diag_wirecap_read_get, VC_NONE,
       INDEX, VC_LEN_VAR, 0, 0, 0, 0, "Captured bytes, 256-byte chunk wValue")
VC_CMD(0x53, WIRECAP_CLKGEN, diag_wirecap_clkgen_get, diag_wirecap_clkgen_set,
       NONE, 24, 5, 5, 0, 0, "I2S clock generator on GPIO 24/25: SET u8 enable, u32 rate; GET status")
VC_CMD(0x54, WIRECAP_CLKGEN_GLITCH, VC_NONE, diag_wirecap_glitch_set,
       NONE, 0, 2, 2, 0, 0, "Inject one clock glitch: u8 kind (1 runt, 2 missing BCK, 3 LRCLK early, 4 late), u8 cells")
VC_CMD(0x55, WIRECAP_RATE, VC_NONE, diag_wirecap_rate_set,
       NONE, 0, 4, 4, 0, 0, "Request an output rate change through the host path, u32 Hz (USB input only)")
#endif

// Shaped soft VCXO bench hooks (soft_vcxo_spec.md section 8.7 has the layouts).
#if DSPI_CLOCK_DIAG && SOFT_VCXO_SHAPED
VC_CMD(0x60, VCXO_STATUS, diag_vcxo_status_get, VC_NONE,
       NONE, 104, 0, 0, 0, 0, "SoftVcxoShapedDiag (104 B): state, counters, modulator, fc0 totals")
VC_CMD(0x61, VCXO_FORCE, diag_vcxo_force_get, diag_vcxo_force_set,
       NONE, 5, 5, 5, 0, 0, "u8 enable, f32 ppm (+-1000): run this trim in place of the servo")
VC_CMD(0x62, VCXO_DELAY, diag_vcxo_delay_get, diag_vcxo_delay_set,
       NONE, 1, 1, 1, 0, 0, "u8 pacer delay d (40..59, default 50); a running pacer parks and restarts")
#endif
